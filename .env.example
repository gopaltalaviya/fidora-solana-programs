# Copy to .env (gitignored). Devnet only; every script refuses mainnet.
# The path of YOUR OWN devnet keypair file, a wallet you hold (never put the key itself here).
# It pays for the deploy and the test runs; test keys are swept back to it.
FIDORA_DEPLOYER_KEYPAIR=
# Optional: the arbiter (a Squads multisig vault). Default: the deployer key.
ARBITER_PUBKEY=
# Optional RPC overrides.
RPC_URL_DEVNET=https://api.devnet.solana.com
RPC_URL_LOCALNET=http://127.0.0.1:8899
